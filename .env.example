# ---- Database (Neon Postgres) ----
# Heroku config var. Example: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Admin panel (/admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-long-random-string

# ---- Sessions ----
JWT_SECRET=change-me-long-random-string

# ---- Global token source (used when Login mode is OFF) ----
STUDYSPARK_TOKEN_URL=https://api.studyspark.study/api/penpencil/v3/oauth/exchange-token
PW_API=https://api.penpencil.co

# ---- Batches ----
# JSON link for the Batches page (also editable live from Admin > Controls)
BATCHES_SOURCE_URL=https://raw.githubusercontent.com/pwxmarco/Batches/refs/heads/main/batches.json
# Banner used for batches that have no image
NEXT_PUBLIC_DEFAULT_BATCH_BANNER=https://i.ibb.co/YT0v1Fcc/file-000000008d1c8211a64b48d531d3d091.png

# ---- Branding ----
NEXT_PUBLIC_APP_NAME=PW-MARCO
NEXT_PUBLIC_TELEGRAM_USERNAME=official_marco_22
NEXT_PUBLIC_TELEGRAM_LINK=https://t.me/official_marco_22

# ---- Lecture stream APIs ----
PRIMARY_STREAM_API=https://og-stream.raghutiwari554-34f.workers.dev/api/{batch_id}/{subject_id}/{lecture_id}
FALLBACK_STREAM_API=https://lecture-stream-api--r9140128682ashw.replit.app/api/{batch_id}/{subject_id}/{topic_id}/{lecture_id}

# ---- Optional helper services ----
DRM_KEY_API=https://pwthorkid.help-codewithvivek.workers.dev
PW_LIVE_API=https://pwapi.vivekkumar980127.workers.dev/

